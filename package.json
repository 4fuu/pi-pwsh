{
  "name": "@4fu/pi-pwsh",
  "version": "0.6.3",
  "description": "Route pi's shell, directory listing, and search tasks through PowerShell 7 on Windows",
  "license": "MIT",
  "author": "4fuu",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/4fuu/pi-pwsh.git"
  },
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "powershell",
    "pwsh",
    "windows"
  ],
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test:pty": "node --experimental-transform-types scripts/smoke-pty.mjs",
    "test:timeout": "node scripts/smoke-timeout.mjs"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.80.10",
    "@earendil-works/pi-tui": "^0.80.10",
    "@types/node": "^24.0.0",
    "typescript": "^5.5.0"
  },
  "dependencies": {
    "@xterm/headless": "^6.0.0",
    "node-pty": "1.1.0"
  }
}
