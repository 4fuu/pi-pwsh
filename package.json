{
  "name": "@4fu/pi-pwsh",
  "version": "0.8.6",
  "description": "Persistent PowerShell tasks for pi on Windows, with ConPTY sessions and user requests.",
  "license": "MIT",
  "author": "4fuu",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/4fuu/pi-pwsh.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "powershell",
    "pwsh",
    "windows"
  ],
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "image": "https://raw.githubusercontent.com/4fuu/pi-pwsh/master/docs/logo.svg"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && npm run test:tasks && npm run test:config && npm run test:runtime && npm run test:transport && npm run test:exitcode && npm run test:output && npm run test:timeout && npm run test:pty",
    "test:tasks": "node --experimental-transform-types scripts/test-tasks.mjs",
    "test:config": "node --experimental-transform-types scripts/smoke-config.mjs",
    "test:exitcode": "node --experimental-transform-types scripts/smoke-exitcode.mjs",
    "test:output": "node --experimental-transform-types scripts/smoke-output.mjs",
    "test:pty": "node --experimental-transform-types scripts/smoke-pty.mjs",
    "test:runtime": "node --experimental-transform-types scripts/smoke-runtime.mjs",
    "test:timeout": "node --experimental-transform-types scripts/smoke-timeout.mjs",
    "test:transport": "node --experimental-transform-types scripts/smoke-transport.mjs"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.0",
    "@earendil-works/pi-tui": "^0.84.0",
    "@types/node": "^24.0.0",
    "typebox": "^1.1.38",
    "typescript": "^5.5.0"
  },
  "dependencies": {
    "@4fu/pi-task-coordinator": "0.1.3",
    "@xterm/headless": "^6.0.0",
    "node-pty": "1.1.0"
  }
}
